#!/bin/sh
# Every commit passes the full check gate (ruff, format, mypy, pytest) before it lands.
# Wired by:  git config core.hooksPath scripts/githooks
# Emergency bypass (a broken tree that must be saved as-is):  git commit --no-verify

root="$(git rev-parse --show-toplevel)" || exit 1
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check.ps1"
