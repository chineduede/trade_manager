Screen {
    background: $background;
}

#body {
    height: 1fr;
}

/* --- sidebar ------------------------------------------------------------------------------ */

#sidebar {
    width: 26;
    padding: 1 2;
    background: $surface;
    border-right: tall $panel;
}

.-narrow #sidebar {
    display: none;
}

#brand {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

#mode {
    padding: 0 1;
    margin-bottom: 2;
    text-style: bold;
}

#mode.dry {
    background: $warning 15%;
    color: $warning;
    border-left: tall $warning;
}

#mode.live {
    background: $error 20%;
    color: $error;
    border-left: tall $error;
}

.nav {
    padding: 0 1;
    margin-bottom: 1;
    color: $text-muted;
    border: round $panel;
}

.nav:hover {
    color: $text;
    background: $panel;
}

.nav.-active {
    color: $text;
    text-style: bold;
    border: round $primary;
}

#spacer {
    height: 1fr;
}

#keys {
    color: $text-muted;
}

/* --- main column -------------------------------------------------------------------------- */

#main {
    padding: 0 1;
}

#statusbar {
    height: 1;
    padding: 0 1;
    margin: 1 0;
    background: $panel;
    color: $text;
}

#statusbar.copying {
    background: $success 25%;
}

#statusbar.copying.live {
    background: $error 30%;
}

#statusbar.halted {
    background: $warning 20%;
}

#pages, #page-terminals, #page-log {
    height: 1fr;
}

#terminals {
    height: 1fr;
    background: $surface;
    border: round $panel;
    border-title-color: $text-muted;
    border-title-style: bold;
}

#terminals:focus {
    border: round $primary 60%;
}

#terminals > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

#terminals > .datatable--cursor {
    background: $primary 20%;
    text-style: none;
}

#terminals > .datatable--hover {
    background: $panel;
}

#actions, #detail {
    height: auto;
    padding: 0 1;
    background: $surface;
    border: round $panel;
    border-title-color: $text-muted;
    border-title-style: bold;
}

#actions {
    max-height: 9;
}

#detail {
    max-height: 12;
    color: $text;
    border-title-color: $primary;
}

#log {
    height: 1fr;
    background: $surface;
    border: round $panel;
    border-title-color: $text-muted;
    border-title-style: bold;
}
