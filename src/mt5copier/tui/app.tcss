/* Cream on warm near-black. Colours are the theme's (see style.py). */

Screen {
    background: $background;
    color: $foreground;
    padding: 0 2;
}

#topbar {
    height: 2;
    padding-top: 1;
}

#pages {
    height: 1fr;
    border-top: double $foreground;
}

#keybar {
    height: 1;
    border-top: solid $panel;
    height: 2;
}

.heading {
    text-style: bold;
    border-bottom: solid $foreground;
    height: 2;
}

.hint {
    color: $text-muted;
    padding: 1 0;
}

/* --- map ----------------------------------------------------------------------------------- */

#page-map {
    padding-top: 1;
    scrollbar-size-vertical: 1;
}

.card {
    border: solid $foreground;
    padding: 1 2;
    height: auto;
}

/* Slave cards in rows of four (two when narrow), as the design has them: one slave is a
   quarter-width card, not a banner, and a row that is not full sits in the middle. Each card's
   width is set from a full row's (see CopierApp._size_cards). Rows are a fixed height so the
   trunk beside them can be drawn the full height of the row. */
#slaves {
    height: auto;
}

.slave-row {
    height: 12;
}

.slave-cards {
    width: 1fr;
    height: 100%;
    align-horizontal: center;
}

.slave-cards > .card {
    height: 100%;
    margin-right: 2;
}

.slave-cards > .card:last-child {
    margin-right: 0;
}

#slaves > .hint {
    margin-top: 1;
}

.card.-paused {
    border: dashed $foreground;
}

.card.-held,
.card.-blocked {
    border: dashed $error;
}

.card.-down {
    border: dashed $panel;
}

/* The master: a slave card's size, centred over the slaves, in a double border that marks it
   out from them. Its width is set from the slaves' (see CopierApp._size_cards). */
#master-row {
    height: 12;
    align-horizontal: center;
}

.card.master {
    height: 100%;
    border: double $foreground;
}

/* Live: the master while it is being copied and each slave taking its trades, in the green of
   the lines between them (see GREEN in style.py). */
.card.-copying {
    border: solid #7fbf6e;
}

.card.master.-live {
    border: double #7fbf6e;
}

/* The selected card: a wash of cream that the card shows through, not a solid fill. */
.card.-selected {
    background: $foreground 20%;
}

#lower {
    height: auto;
    margin-top: 2;
}

#daybook-col {
    width: 3fr;
    height: auto;
    margin-right: 4;
}

#notyet-col {
    width: 2fr;
    height: auto;
}

.-narrow #lower {
    layout: vertical;
}

.-narrow #daybook-col {
    width: 1fr;
    margin-right: 0;
    margin-bottom: 1;
}

.-narrow #notyet-col {
    width: 1fr;
}

#daybook {
    height: auto;
}

#chips {
    padding-top: 1;
}

#notyet-hint {
    color: $text-muted;
    padding-top: 1;
}

/* --- log ----------------------------------------------------------------------------------- */

#logbar {
    height: 1;
    margin: 1 0;
}

#log {
    background: $background;
    border: none;
    height: 1fr;
}

#log:focus {
    background-tint: $foreground 0%;
}

#log > .datatable--header {
    background: $background;
}

/* The line under the cursor: filled in cream, as the design's selected log line is. */
#log > .datatable--cursor {
    background: $foreground;
    color: $background;
}

#log > .datatable--hover {
    background: $foreground 10%;
}

/* --- the action menu ----------------------------------------------------------------------- */

/* A screen of its own, so it would take the Screen rule above: solid, and padded, which would
   both hide the Map under it and push the menu off the terminal it belongs to. */
ActionMenu {
    background: $background 0%;
    padding: 0;
}

ActionMenu > #menu {
    border: double $foreground;
    border-title-color: $foreground;
    border-title-style: bold;
    background: $background;
    height: auto;
}

ActionMenu OptionList,
ActionMenu OptionList:focus {
    border: none;
    background: $background;
    color: $foreground;
    height: auto;
    padding: 0 1;
    scrollbar-size-vertical: 0;
}

ActionMenu OptionList > .option-list--option-highlighted,
ActionMenu OptionList:focus > .option-list--option-highlighted {
    background: $foreground;
    color: $background;
    text-style: bold;
}

/* --- a terminal's details ------------------------------------------------------------------ */

#td-page {
    padding-top: 1;
    scrollbar-size-vertical: 1;
}

/* The band: the terminal's name and equity, dark on cream, as the design has it. */
#td-band {
    background: $foreground;
    color: $background;
    padding: 1 2;
    height: auto;
}

#td-notes {
    height: auto;
    padding: 1 0 0 0;
}

#td-columns {
    height: auto;
    margin-top: 1;
}

.td-col {
    width: 1fr;
    height: auto;
    margin-right: 4;
}

.td-col:last-child {
    margin-right: 0;
}

.-narrow #td-columns {
    layout: vertical;
}

.-narrow .td-col {
    margin-right: 0;
    margin-bottom: 1;
}

#td-account, #td-rule, #td-copying {
    height: auto;
}

/* Each order's delay, oldest first: blue, turning red toward the slowest. */
#td-latency {
    height: 3;
    margin-top: 1;
    border-top: solid $panel;
    border-title-color: $text-muted;
    border-title-align: left;
}

#td-latency > .sparkline--min-color {
    color: $secondary;
}

#td-latency > .sparkline--max-color {
    color: $error;
}

#td-positions-head {
    margin-top: 2;
}

#td-positions {
    background: $background;
    border: none;
    height: auto;
}

#td-positions:focus {
    background-tint: $foreground 0%;
}

#td-positions > .datatable--header {
    background: $background;
}

#td-positions > .datatable--cursor {
    background: $foreground;
    color: $background;
}

#td-positions > .datatable--hover {
    background: $foreground 10%;
}

/* --- an account's guards ------------------------------------------------------------------ */

#gd-page {
    padding-top: 1;
    scrollbar-size-vertical: 1;
}

/* The same cream band as a terminal's details. */
#gd-band {
    background: $foreground;
    color: $background;
    padding: 1 2;
    height: auto;
}

#gd-note, #gd-account, #gd-empty, #gd-said, #gd-actions {
    height: auto;
    margin-top: 1;
}

#gd-rules-head, #gd-actions-head {
    margin-top: 2;
}

#gd-rules {
    background: $background;
    border: none;
    height: auto;
}

#gd-rules:focus {
    background-tint: $foreground 0%;
}

#gd-rules > .datatable--header {
    background: $background;
}

#gd-rules > .datatable--cursor {
    background: $foreground 18%;
}

#gd-rules > .datatable--hover {
    background: $foreground 10%;
}

#gd-ask {
    display: none;
    height: 1;
    margin-top: 1;
}

#gd-ask-what, #gd-ask .w {
    width: auto;
}

#gd-ask-box {
    width: 24;
}

#gd-ask-box:focus {
    background: $foreground 30%;
}

#gd-ask-error {
    display: none;
    height: auto;
}

/* --- saved setups ------------------------------------------------------------------------ */

#st-page {
    padding-top: 1;
    scrollbar-size-vertical: 1;
}

#st-band {
    background: $foreground;
    color: $background;
    padding: 1 2;
    height: auto;
}

#st-note, #st-now, #st-empty, #st-said {
    height: auto;
    margin-top: 1;
}

#st-head {
    margin-top: 2;
}

#st-table {
    background: $background;
    border: none;
    height: auto;
}

#st-table:focus {
    background-tint: $foreground 0%;
}

#st-table > .datatable--header {
    background: $background;
}

#st-table > .datatable--cursor {
    background: $foreground 18%;
}

#st-table > .datatable--hover {
    background: $foreground 10%;
}

#st-ask {
    display: none;
    height: 1;
    margin-top: 1;
}

#st-ask-what, #st-ask .w {
    width: auto;
}

#st-ask-box {
    width: 32;
}

#st-ask-box:focus {
    background: $foreground 30%;
}

#st-ask-error {
    display: none;
    height: auto;
}

/* --- a slave's trade history -------------------------------------------------------------- */

#hs-page {
    padding-top: 1;
    scrollbar-size-vertical: 1;
}

#hs-band {
    background: $foreground;
    color: $background;
    padding: 1 2;
    height: auto;
}

#hs-head {
    margin-top: 1;
}

#hs-empty {
    height: auto;
    margin-top: 1;
}

#hs-cards {
    height: auto;
}

/* A card per copied trade, in the map's card language: green while it is open on the slave,
   red dashed when a step with it failed. */
.hs-card {
    border: solid $foreground 40%;
    border-title-color: $foreground;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 0 1;
    margin-top: 1;
    height: auto;
}

.hs-card.-open {
    border: solid #7fbf6e;
}

.hs-card.-failed {
    border: dashed $error;
}

/* --- the questions that guard money -------------------------------------------------------- */

/* Screens of their own, so they would take the Screen rule at the top: solid and padded. They
   dim what is under them instead, and sit in the middle of it. */
OrphanDialog,
LiveDialog,
GoLiveDialog,
CTraderDialog,
GuardConfirm {
    background: #0c0b09 80%;
    padding: 0;
    align: center middle;
}

OrphanDialog #dialog,
LiveDialog #dialog,
GoLiveDialog #dialog,
GuardConfirm #dialog,
CTraderDialog #dialog {
    width: 96;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: double $error;
    background: $background;
    padding: 1 4;
    scrollbar-size-vertical: 1;
}

.dialog Static {
    margin-top: 1;
    height: auto;
}

.dialog .dialog-title {
    margin-top: 0;
    border-bottom: solid $error;
}

.dialog #copies {
    margin-top: 1;
}

.dialog #typed-box {
    height: 3;
    margin-top: 1;
    border: solid $foreground;
    padding: 0 1;
}

.dialog #typed-box Input,
.dialog #typed-box Input:focus {
    width: 1fr;
    background: $background;
    background-tint: $foreground 0%;
    border: none;
    padding: 0;
}

.dialog #typed-box #to-go {
    width: auto;
    margin: 0 0 0 2;
}

.dialog #error {
    color: $error;
}

/* The cTrader login's labelled inputs. */
CTraderDialog #dialog {
    border: double $foreground;
}

CTraderDialog .dialog-title {
    border-bottom: solid $foreground;
}

CTraderDialog .field {
    height: 1;
    margin-top: 1;
}

CTraderDialog .field .field-label {
    width: 14;
    margin-top: 0;
    color: $text-muted;
}

CTraderDialog .field Input {
    width: 1fr;
}

/* Shown only when there is something to say: the guard's dialog would otherwise keep an empty
   line for it. */
LiveDialog #error {
    display: none;
    height: auto;
}

/* Docked, so on a short terminal the question scrolls and its answers stay in sight. */
.dialog #buttons {
    dock: bottom;
    height: auto;
    margin-top: 1;
    padding-top: 1;
    border-top: solid $foreground;
    align-horizontal: right;
    background: $background;
}

/* Short: less room around the question, so more of it shows. */
.-short OrphanDialog #dialog,
.-short LiveDialog #dialog,
.-short GoLiveDialog #dialog,
OrphanDialog.-short #dialog,
LiveDialog.-short #dialog,
GoLiveDialog.-short #dialog {
    padding: 0 2;
}

.-short .dialog #buttons,
.dialog.-short #buttons {
    padding-top: 0;
}

.dialog Button {
    height: 3;
    min-width: 16;
    margin-left: 3;
    text-style: bold;
    border: none;
    content-align: center middle;
}

/* Both answers are solid blocks of one size (ButtonRow evens their widths), so neither looks
   bigger than the other: an outline is drawn through the middle of its edge rows and looks a row
   shorter than a filled block beside it. The one enter would press is filled in full; the other
   is dimmed. Not underlined: text style covers a button's blank rows too, which would draw lines
   above and below. */
.dialog Button.keep {
    background: $foreground 55%;
    color: $background;
}

.dialog Button.keep:hover {
    background: $foreground 80%;
}

.dialog Button.keep:focus {
    background: $foreground;
}

.dialog Button.danger {
    background: $error 20%;
    color: $error;
}

.dialog Button.danger:hover {
    background: $error 35%;
}

.dialog Button.danger:focus {
    background: $error;
    color: $background;
}

/* Not yet: the name is not typed in full. Still pressable, to be told why not. */
.dialog Button.danger.-waiting {
    background: $panel 60%;
    color: $text-muted;
}

/* --- the settings forms --------------------------------------------------------------------- */

/* A slave's settings and the copier's own, both written as sentences. */
.form-screen {
    background: #0c0b09 80%;
    padding: 0;
    align: center middle;
}

.form-screen #dialog {
    width: 116;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: thick $foreground;
    background: $background;
    padding: 0 2;
    scrollbar-size-vertical: 1;
}

.form-screen #st-head {
    height: 2;
    border-bottom: double $foreground;
}

.form-screen #st-title {
    width: 1fr;
}

.form-screen #st-where {
    width: auto;
}

.form-screen #st-mode {
    margin-bottom: 1;
}


.form-screen .sect {
    height: auto;
    border-top: solid $panel;
}

.form-screen .sect-name {
    width: 12;
    text-style: bold;
}

.form-screen .sect-body {
    width: 1fr;
    height: auto;
}

/* A blank row under every line of a section, as the design spaces them, so nothing in one
   line sits hard against the next. The last line's is the section's bottom margin. */
.form-screen .line {
    height: auto;
    margin-bottom: 1;
}

.form-screen .part {
    width: auto;
    height: auto;
}

/* Narrow: a section's name goes above its sentences, which then have the whole width. */
.-narrow .form-screen .sect,
.form-screen.-narrow .sect {
    layout: vertical;
}

.-narrow .form-screen .sect-name,
.form-screen.-narrow .sect-name {
    width: 1fr;
    margin-bottom: 1;
}

.form-screen .w {
    width: auto;
}

.form-screen Input,
.form-screen Input:focus {
    height: 1;
    padding: 0 1;
    border: none;
    background: $panel 45%;
    color: $foreground;
    text-style: bold;
}

.form-screen Input:focus {
    background: $foreground 30%;
    color: $foreground;
}

.form-screen Input > .input--placeholder {
    color: $text-muted;
    text-style: not bold;
}

.form-screen Input.n5 { width: 7; }
.form-screen Input.n6 { width: 8; }
.form-screen Input.n8 { width: 10; }
.form-screen Input.n10 { width: 12; }
.form-screen Input.n12 { width: 14; }
.form-screen Input.grow { width: 1fr; min-width: 12; }


.form-screen Tick {
    width: auto;
    margin-right: 2;
    background: $background;
    padding: 0;
}

.form-screen Tick:focus {
    background: $foreground 30%;
}

.form-screen Tick:focus > .toggle--label {
    background: transparent;
    color: $foreground;
    text-style: bold;
}

.form-screen .err {
    display: none;
    height: auto;
    color: $error;
}

.form-screen #example {
    height: auto;
    border: solid $panel;
    padding: 0 1;
}

.form-screen #ex-name {
    width: 10;
    color: $text-muted;
    text-style: bold;
}

.form-screen #ex-body {
    width: 1fr;
    height: auto;
}

.form-screen #help {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: $background;
}

.form-screen #general-error {
    display: none;
    height: auto;
    color: $error;
    text-style: bold;
}

/* Docked, so Save and Cancel stay in sight while a short terminal scrolls the form. */
.form-screen #st-foot {
    dock: bottom;
    height: auto;
    padding: 1 0;
    border-top: solid $foreground;
    align-vertical: middle;
    background: $background;
}

.-short .form-screen #st-foot,
.form-screen.-short #st-foot {
    padding: 0;
}

.form-screen #st-stake {
    width: 1fr;
    margin-top: 1;
}

.form-screen #st-buttons {
    width: auto;
    height: auto;
}

/* Four buttons leave the words beside them a sliver on a narrow screen: the words go above. */
.-narrow .form-screen #st-foot.stacks,
.form-screen.-narrow #st-foot.stacks {
    layout: vertical;
}

.-narrow .form-screen #st-foot.stacks #st-stake,
.form-screen.-narrow #st-foot.stacks #st-stake {
    height: auto;
    margin-top: 0;
}

.-narrow .form-screen #st-foot.stacks #st-buttons,
.form-screen.-narrow #st-foot.stacks #st-buttons {
    width: 1fr;
    align-horizontal: right;
}

.form-screen Button {
    height: 3;
    min-width: 16;
    margin-left: 2;
    text-style: bold;
}

/* Save is filled cream, as the design has it; cancel is a dim block. Whichever has focus turns
   blue, the colour of the copier doing its job. No borders: a block border leaves a sliver of
   its edge beside the button in most terminal fonts. */
.form-screen Button.keep,
.form-screen Button.keep:hover {
    background: $foreground;
    color: $background;
    border: none;
    content-align: center middle;
}

.form-screen Button.plain,
.form-screen Button.plain:hover {
    background: $panel 60%;
    color: $foreground;
    border: none;
    content-align: center middle;
}

.form-screen Button.keep:focus,
.form-screen Button.plain:focus {
    background: $accent;
    color: $background;
}

/* --- the log's search ---------------------------------------------------------------------- */

#searchbar {
    height: 1;
    margin-bottom: 1;
    display: none;
}

#log-search {
    width: 1fr;
}

#searchbar > Static {
    width: auto;
}

#log-search:focus {
    background: $foreground 30%;
}

/* --- a copy's breakeven price, typed in place ----------------------------------------------- */

#td-be {
    height: 1;
    margin-top: 1;
    display: none;
}

#td-be > Static {
    width: auto;
}

#td-be-price {
    width: 16;
}

#td-be-price:focus {
    background: $foreground 30%;
}

#td-be-error {
    display: none;
}

/* --- direct trading ------------------------------------------------------------------------ */

#dt-page {
    padding-top: 1;
    scrollbar-size-vertical: 1;
}

#dt-band {
    background: $foreground;
    color: $background;
    padding: 1 2;
    height: auto;
}

#dt-page .heading {
    margin-top: 1;
}

.dt-row {
    height: 1;
    margin: 0 2;
}

.dt-row .dt-label {
    width: auto;
}

.dt-row Input {
    background: $foreground 12%;
}

.dt-row Input:focus {
    background: $foreground 30%;
}

.dt-row .dt-symbol {
    width: 12;
}

.dt-row .dt-num {
    width: 9;
}

.dt-row .dt-rr {
    width: 6;
}

/* The place button is the trade's side, said in its colour: blue is a buy (the copier's
   working colour), red a sell -- the same coding as the book's rows. */
.dt-actions {
    margin-top: 1;
}

#dt-place.buy {
    background: $accent 85%;
    color: $background;
    text-style: bold;
}

#dt-place.buy:hover, #dt-place.buy:focus {
    background: $accent;
}

#dt-place.sell {
    background: $error 85%;
    color: $background;
    text-style: bold;
}

#dt-place.sell:hover, #dt-place.sell:focus {
    background: $error;
}

#dt-reset {
    margin-left: 2;
    background: $foreground 12%;
    color: $foreground;
}

#dt-reset:hover, #dt-reset:focus {
    background: $foreground 30%;
}

#dt-quote, #dt-status {
    height: auto;
    margin: 1 2 0 2;
}

#dt-chart-head {
    margin-top: 1;
}

#dt-chart {
    height: auto;
    margin: 0 2;
}

#dt-book {
    background: $background;
    border: none;
    height: auto;
    margin: 0 2;
}

#dt-book:focus {
    background-tint: $foreground 0%;
}

#dt-book > .datatable--header {
    background: $background;
}

#dt-book > .datatable--cursor {
    background: $foreground 18%;
}

#dt-book > .datatable--hover {
    background: $foreground 10%;
}

#dt-ask {
    height: 1;
    margin: 1 2 0 2;
}

#dt-ask-what, #dt-ask .w {
    width: auto;
}

#dt-ask-box {
    width: 32;
}

#dt-ask-box:focus {
    background: $foreground 30%;
}
