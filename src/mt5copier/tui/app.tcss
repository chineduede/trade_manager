Screen {
    layout: vertical;
}

#statusbar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#statusbar.copying {
    background: $success-darken-1;
}

#statusbar.halted {
    background: $warning-darken-2;
}

#terminals {
    height: 1fr;
    border: none;
}

#actions {
    height: auto;
    max-height: 7;
    padding: 0 1;
    background: $surface-darken-1;
    color: $text;
    border-top: solid $panel;
}

#detail {
    height: auto;
    max-height: 6;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
    border-top: solid $panel;
}
