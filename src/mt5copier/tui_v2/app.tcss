/* The new UI: cream on warm near-black. Colours are the theme's (see style.py). */

Screen {
    background: $background;
    color: $foreground;
    padding: 0 2;
}

#topbar {
    height: 2;
    padding-top: 1;
}

#pages {
    height: 1fr;
    border-top: double $foreground;
}

#keybar {
    height: 1;
    border-top: solid $panel;
    height: 2;
}

.heading {
    text-style: bold;
    border-bottom: solid $foreground;
    height: 2;
}

.hint {
    color: $text-muted;
    padding: 1 0;
}

/* --- map ----------------------------------------------------------------------------------- */

#page-map {
    padding-top: 1;
    scrollbar-size-vertical: 1;
}

.card {
    border: solid $foreground;
    padding: 1 2;
    height: auto;
}

/* Slave cards in rows of four (two when narrow), as the design has them: one slave is a
   quarter-width card, not a banner. Rows are a fixed height so the trunk beside them can be
   drawn the full height of the row. */
#slaves {
    height: auto;
}

.slave-row {
    height: 12;
}

.slave-row > .card,
.slave-row > .slot {
    width: 1fr;
    height: 100%;
    margin-right: 2;
}

.slave-row > .card:last-child,
.slave-row > .slot:last-child {
    margin-right: 0;
}

#slaves > .hint {
    margin-top: 1;
}

.card.-paused {
    border: dashed $foreground;
}

.card.-held,
.card.-blocked {
    border: dashed $error;
}

.card.-down {
    border: dashed $panel;
}

/* Live: the master while it is being copied and each slave taking its trades, in the green of
   the lines between them (see GREEN in style.py). */
.card.master.-live,
.card.-copying {
    border: solid #7fbf6e;
}

/* The selected card: a wash of cream that the card shows through, not a solid fill. */
.card.-selected {
    background: $foreground 20%;
}

#lower {
    height: auto;
    margin-top: 2;
}

#daybook-col {
    width: 3fr;
    height: auto;
    margin-right: 4;
}

#notyet-col {
    width: 2fr;
    height: auto;
}

.-narrow #lower {
    layout: vertical;
}

.-narrow #daybook-col {
    width: 1fr;
    margin-right: 0;
    margin-bottom: 1;
}

.-narrow #notyet-col {
    width: 1fr;
}

#daybook {
    height: auto;
}

#chips {
    padding-top: 1;
}

#notyet-hint {
    color: $text-muted;
    padding-top: 1;
}

/* --- log ----------------------------------------------------------------------------------- */

#logbar {
    height: 1;
    margin: 1 0;
}

#log {
    background: $background;
    border: none;
    height: 1fr;
}

#log:focus {
    background-tint: $foreground 0%;
}

#log > .datatable--header {
    background: $background;
}

/* The line under the cursor: filled in cream, as the design's selected log line is. */
#log > .datatable--cursor {
    background: $foreground;
    color: $background;
}

#log > .datatable--hover {
    background: $foreground 10%;
}

/* --- the action menu ----------------------------------------------------------------------- */

/* A screen of its own, so it would take the Screen rule above: solid, and padded, which would
   both hide the Map under it and push the menu off the terminal it belongs to. */
ActionMenu {
    background: $background 0%;
    padding: 0;
}

ActionMenu > #menu {
    border: double $foreground;
    border-title-color: $foreground;
    border-title-style: bold;
    background: $background;
    height: auto;
}

ActionMenu OptionList,
ActionMenu OptionList:focus {
    border: none;
    background: $background;
    color: $foreground;
    height: auto;
    padding: 0 1;
    scrollbar-size-vertical: 0;
}

ActionMenu OptionList > .option-list--option-highlighted,
ActionMenu OptionList:focus > .option-list--option-highlighted {
    background: $foreground;
    color: $background;
    text-style: bold;
}

/* --- a terminal's details ------------------------------------------------------------------ */

#td-page {
    padding-top: 1;
    scrollbar-size-vertical: 1;
}

/* The band: the terminal's name and equity, dark on cream, as the design has it. */
#td-band {
    background: $foreground;
    color: $background;
    padding: 1 2;
    height: auto;
}

#td-notes {
    height: auto;
    padding: 1 0 0 0;
}

#td-columns {
    height: auto;
    margin-top: 1;
}

.td-col {
    width: 1fr;
    height: auto;
    margin-right: 4;
}

.td-col:last-child {
    margin-right: 0;
}

.-narrow #td-columns {
    layout: vertical;
}

.-narrow .td-col {
    margin-right: 0;
    margin-bottom: 1;
}

#td-account, #td-rule, #td-copying {
    height: auto;
}

/* Each order's delay, oldest first: blue, turning red toward the slowest. */
#td-latency {
    height: 3;
    margin-top: 1;
    border-top: solid $panel;
    border-title-color: $text-muted;
    border-title-align: left;
}

#td-latency > .sparkline--min-color {
    color: $secondary;
}

#td-latency > .sparkline--max-color {
    color: $error;
}

#td-positions-head {
    margin-top: 2;
}

#td-positions {
    background: $background;
    border: none;
    height: auto;
}

#td-positions:focus {
    background-tint: $foreground 0%;
}

#td-positions > .datatable--header {
    background: $background;
}

#td-positions > .datatable--cursor {
    background: $foreground;
    color: $background;
}

#td-positions > .datatable--hover {
    background: $foreground 10%;
}

/* --- the questions that guard money -------------------------------------------------------- */

/* Screens of their own, so they would take the Screen rule at the top: solid and padded. They
   dim what is under them instead, and sit in the middle of it. */
OrphanDialog,
LiveDialog,
GoLiveDialog {
    background: #0c0b09 80%;
    padding: 0;
    align: center middle;
}

OrphanDialog #dialog,
LiveDialog #dialog,
GoLiveDialog #dialog {
    width: 96;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: double $error;
    background: $background;
    padding: 1 4;
    scrollbar-size-vertical: 1;
}

.dialog Static {
    margin-top: 1;
    height: auto;
}

.dialog .dialog-title {
    margin-top: 0;
    border-bottom: solid $error;
}

.dialog #copies {
    margin-top: 1;
}

.dialog #typed-box {
    height: 3;
    margin-top: 1;
    border: solid $foreground;
    padding: 0 1;
}

.dialog #typed-box Input,
.dialog #typed-box Input:focus {
    width: 1fr;
    background: $background;
    background-tint: $foreground 0%;
    border: none;
    padding: 0;
}

.dialog #typed-box #to-go {
    width: auto;
    margin: 0 0 0 2;
}

.dialog #error {
    color: $error;
}

.dialog #buttons {
    height: auto;
    margin-top: 1;
    padding-top: 1;
    border-top: solid $foreground;
    align-horizontal: right;
}

.dialog Button {
    height: 3;
    min-width: 16;
    margin-left: 3;
    text-style: bold;
}

.dialog Button.keep {
    background: $foreground;
    color: $background;
    border: none;
    content-align: center middle;
}

.dialog Button.danger {
    background: $background;
    color: $error;
    border: solid $error;
}

/* Not yet: the name is not typed in full. Still pressable, to be told why not. */
.dialog Button.danger.-waiting {
    color: $text-muted;
    border: dashed $panel;
}

/* The button that enter would press is filled in full; the other is dimmed. Not underlined:
   text style covers a button's blank rows too, which would draw lines above and below. */
.dialog Button.keep {
    background: $foreground 55%;
}

.dialog Button.keep:focus {
    background: $foreground;
}

.dialog Button.danger:focus {
    background: $error 25%;
}

.dialog Button:focus,
.dialog Button:hover {
    text-style: bold;
}

.dialog Button.keep:hover {
    background: $foreground 80%;
}

.dialog Button.danger:hover {
    background: $error 15%;
}

/* --- the settings forms --------------------------------------------------------------------- */

/* A slave's settings and the copier's own, both written as sentences. The slave's form is the
   classic one underneath, whose own rules still reach it, so the ones that would show through
   are put back here: its error indent, its help panel, its fixed field widths. */
.form-screen {
    background: #0c0b09 80%;
    padding: 0;
    align: center middle;
}

.form-screen #dialog {
    width: 116;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: thick $foreground;
    background: $background;
    padding: 0 2;
    scrollbar-size-vertical: 1;
}

.form-screen #st-head {
    height: 2;
    border-bottom: double $foreground;
}

.form-screen #st-title {
    width: 1fr;
}

.form-screen #st-where {
    width: auto;
}

.form-screen #st-mode {
    margin-bottom: 1;
}


.form-screen .sect {
    height: auto;
    border-top: solid $panel;
}

.form-screen .sect-name {
    width: 12;
    text-style: bold;
}

.form-screen .sect-body {
    width: 1fr;
    height: auto;
}

/* A blank row under every line of a section, as the design spaces them, so nothing in one
   line sits hard against the next. The last line's is the section's bottom margin. */
.form-screen .line {
    height: 1;
    margin-bottom: 1;
}

.form-screen .part {
    width: auto;
    height: 1;
}

.form-screen .w {
    width: auto;
}

.form-screen Input,
.form-screen Input:focus {
    height: 1;
    padding: 0 1;
    border: none;
    background: $panel 45%;
    color: $foreground;
    text-style: bold;
}

.form-screen Input:focus {
    background: $foreground 30%;
    color: $foreground;
}

.form-screen Input > .input--placeholder {
    color: $text-muted;
    text-style: not bold;
}

.form-screen Input.n5 { width: 7; }
.form-screen Input.n6 { width: 8; }
.form-screen Input.n8 { width: 10; }
.form-screen Input.n10 { width: 12; }
.form-screen Input.n12 { width: 14; }
.form-screen Input.grow { width: 1fr; min-width: 12; }


.form-screen Tick {
    width: auto;
    margin-right: 2;
    background: $background;
    padding: 0;
}

.form-screen Tick:focus {
    background: $foreground 30%;
}

.form-screen Tick:focus > .toggle--label {
    background: transparent;
    color: $foreground;
    text-style: bold;
}

.form-screen .err {
    display: none;
    height: auto;
    color: $error;
}

.form-screen #example {
    height: auto;
    border: solid $panel;
    padding: 0 1;
}

.form-screen #ex-name {
    width: 10;
    color: $text-muted;
    text-style: bold;
}

.form-screen #ex-body {
    width: 1fr;
    height: auto;
}

.form-screen #help {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: $background;
}

.form-screen #general-error {
    display: none;
    height: auto;
    color: $error;
    text-style: bold;
}

.form-screen #st-foot {
    height: auto;
    padding: 1 0;
    border-top: solid $foreground;
    align-vertical: middle;
}

.form-screen #st-stake {
    width: 1fr;
    margin-top: 1;
}

.form-screen Button {
    height: 3;
    min-width: 16;
    margin-left: 2;
    text-style: bold;
}

/* Save is filled cream, as the design has it; cancel is a dim block. Whichever has focus turns
   blue, the colour of the copier doing its job. No borders: a block border leaves a sliver of
   its edge beside the button in most terminal fonts. */
.form-screen Button.keep,
.form-screen Button.keep:hover {
    background: $foreground;
    color: $background;
    border: none;
    content-align: center middle;
}

.form-screen Button.plain,
.form-screen Button.plain:hover {
    background: $panel 60%;
    color: $foreground;
    border: none;
    content-align: center middle;
}

.form-screen Button.keep:focus,
.form-screen Button.plain:focus {
    background: $accent;
    color: $background;
}
